# =============================================================================
# EmDash on Sevalla — environment variables.
#
# On Sevalla, set these under Applications → <app> → Environment variables
# (runtime). None of them are needed at build time.
#
# Locally: `cp .env.example .env`. The defaults below point at the services in
# docker-compose.yml (`docker compose up -d db s3 createbucket`).
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public origin of the site. Required before the setup wizard runs on a public
# host: passkeys, login redirects, sitemap and canonical URLs use it.
# On Sevalla: https://<app>.sevalla.app, or your custom domain.
EMDASH_SITE_URL=http://localhost:4321

# Encrypts plugin secrets stored in the database. Generate once with
# `npx emdash secrets generate` and keep a copy in a password manager.
EMDASH_ENCRYPTION_KEY=

# --- Database: Sevalla managed PostgreSQL --------------------------------------
# Use the *internal* connection URL (Database → Info → Internal connection
# details) after adding the app as an internal connection.
DATABASE_URL=postgres://emdash:emdash@localhost:5432/emdash

# --- Media: Sevalla Object Storage ----------------------------------------------
# Bucket → Settings: Endpoint, Bucket name, Access key, Secret key.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=emdash-media
S3_ACCESS_KEY_ID=s3admin
S3_SECRET_ACCESS_KEY=s3admin-secret
S3_REGION=auto
# Bucket → Settings → CDN domain (https://<bucket>.sevalla.storage). Media is
# then served straight from Sevalla's storage CDN. Leave empty to serve media
# through the app (/_emdash/api/media/file/...).
S3_PUBLIC_URL=http://localhost:9000/emdash-media

# --- Edge cache: Sevalla Edge Caching + CDN -------------------------------------
# Lets the app purge Sevalla's edge cache when content is published/changed.
# Application ID: Applications → <app> → Settings (or `sevalla apps list`).
# API key: Company settings → API keys (needs permission to purge app cache).
SEVALLA_APP_ID=
SEVALLA_API_KEY=
# Edge TTL / stale-while-revalidate for rendered pages, in seconds.
# EDGE_CACHE_MAX_AGE=3600
# EDGE_CACHE_SWR=86400
